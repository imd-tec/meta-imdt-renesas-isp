+/* Custom match function to only match SOC subdevices */
+static bool acamera_camera_async_match_soc(struct device *dev, struct v4l2_async_subdev *asd)
+{
+	/* Match platform devices with names starting with "soc_" */
+	if (dev && dev->driver && dev->driver->name) {
+		LOG(LOG_DEBUG, "Checking subdev driver: %s", dev->driver->name);
+		if (strncmp(dev->driver->name, "soc_", 4) == 0) {
+			LOG(LOG_DEBUG, "MATCHED SOC subdev driver: %s", dev->driver->name);
+			return true;
+		} else {
+			LOG(LOG_DEBUG, "REJECTED non-SOC subdev driver: %s", dev->driver->name);
+		}
+	} else {
+		LOG(LOG_DEBUG, "Checking subdev with no driver name (dev=%p, driver=%p)",
+		    dev, dev ? dev->driver : NULL);
+	}
+
+	return false;
+}
 
