@@ -0,0 +1,392 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Mali ISP sensor driver that forwards gain and exposure to a V4L2 sensor subdev
+ *
+ * Copyright (C) 2025 - IMD technologies
+ *
+ * Based on the Dummy_drv.c sensor template, Copyright (C) 2016-2022 ARM or its affiliates
+ */
+
+#include <linux/i2c.h>
+#include "acamera_types.h"
+#include "acamera_logger.h"
+#include "acamera_math.h"
+#include "acamera_command_api.h"
+#include "acamera_sbus_api.h"
+#include "system_sensor.h"
+#include "acamera_sensor_api.h"
+#include "system_timer.h"
+#include "acamera_firmware_config.h"
+#include "sensor_bus_config.h"
+#include <media/v4l2-subdev.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/acamera_v4l2_bridge.h>
+
+#define LANE_MBPS 891
+#define PIXEL_AREA_1920x1080 {.horizontal = {0, 0, 0, 1920, 0, 0, 0}, .vertical = {0, 0, 0, 1080, 0, 0, 0}}
+#define MARGIN_BOTTOM 8
+
+typedef struct _sensor_context_t {
+    uint8_t address; // Sensor address for direct write (not used currently)
+    acamera_sbus_t sbus;
+    sensor_param_t param;
+    struct v4l2_subdev *v4l_subdev;
+    int32_t again_log2;
+    uint8_t again_change;
+    int32_t dgain_log2;
+    uint8_t dgain_change;
+    uint8_t exposure_change;
+    uint16_t int_time;
+} sensor_context_t;
+
+static sensor_context_t s_ctx[FIRMWARE_CONTEXT_NUMBER];
+static int ctx_counter = 0;
+static uint32_t reset_state = 0;
+
+static sensor_mode_t supported_modes[] = {
+      {
+        .wdr_mode = WDR_MODE_LINEAR,
+        .fps = 60 * 256,
+        .resolution.width = 1920,
+        .resolution.height = 1080,
+        .bits = 10,
+        .exposures = 1,
+        .seq_table_index = 0,
+        .sensor_settings = {
+            .pixel_area = PIXEL_AREA_1920x1080,
+            .mbps = LANE_MBPS,
+        }
+    }
+};
+
+//*************************************************************************************
+//--------------------DATA-------------------------------------------------------------
+//--------------------RESET------------------------------------------------------------
+static void sensor_hw_reset_enable( void )
+{
+    LOG( LOG_INFO, "V4L2 sensor hw_reset_enable called." );
+    reset_state &= ~( 1 << ( 2 * ( ctx_counter - 1 ) ) );
+    system_reset_sensor( reset_state );
+    system_timer_usleep( 10000 );
+}
+
+static void sensor_hw_reset_disable( void )
+{
+    LOG( LOG_INFO, "V4L2 sensor hw_reset_disable called." );
+    reset_state |= 1 << ( 2 * ( ctx_counter - 1 ) );
+    system_reset_sensor( reset_state );
+    system_timer_usleep( 10000 );
+}
+
+static int get_maximum_again(sensor_context_t * p_ctx)
+{
+    struct v4l2_ctrl *ctrl;
+    int32_t max_again = 0;
+
+    /* Find the control within the subdev's handler */
+    ctrl = v4l2_ctrl_find(p_ctx->v4l_subdev->ctrl_handler, V4L2_CID_ACAMERA_SET_AGAIN_LOG2);
+    if (ctrl)
+    {
+        max_again = ctrl->maximum;
+        LOG( LOG_INFO, "V4L2 sensor get_maximum_again: max_again=%d", max_again );
+    }
+    else
+    {
+        LOG( LOG_ERR, "V4L2 sensor get_maximum_again: control not found!" );
+    }
+    return max_again;
+}
+
+static int get_maximum_dgain(sensor_context_t * p_ctx)
+{
+    struct v4l2_ctrl *ctrl;
+    int32_t max_dgain = 0;
+
+    /* Find the control within the subdev's handler */
+    ctrl = v4l2_ctrl_find(p_ctx->v4l_subdev->ctrl_handler, V4L2_CID_ACAMERA_SET_DGAIN_LOG2);
+    if (ctrl)
+    {
+        max_dgain = ctrl->maximum;
+        LOG( LOG_INFO, "V4L2 sensor get_maximum_dgain: max_dgain=%d", max_dgain );
+    }
+    else
+    {
+        LOG( LOG_ERR, "V4L2 sensor get_maximum_dgain: control not found!" );
+    }
+    return max_dgain;
+}
+
+static int get_minimum_exposure(sensor_context_t * p_ctx)
+{
+    struct v4l2_ctrl *ctrl;
+    int32_t min_exposure = 0;
+
+    /* Find the control within the subdev's handler */
+    ctrl = v4l2_ctrl_find(p_ctx->v4l_subdev->ctrl_handler, V4L2_CID_ACAMERA_SENSOR_EXPOSURE_LINES);
+    if (ctrl)
+    {
+        min_exposure = ctrl->minimum;
+        LOG( LOG_INFO, "V4L2 sensor get_minimum_exposure: min_exposure=%d", min_exposure );
+    }
+    else
+    {
+        LOG( LOG_ERR, "V4L2 sensor get_minimum_exposure: control not found!" );
+    }
+    return min_exposure;
+}
+
+static int get_maximum_exposure(sensor_context_t * p_ctx)
+{
+    struct v4l2_ctrl *ctrl;
+    int32_t max_exposure = 0;
+
+    /* Find the control within the subdev's handler */
+    ctrl = v4l2_ctrl_find(p_ctx->v4l_subdev->ctrl_handler, V4L2_CID_ACAMERA_SENSOR_EXPOSURE_LINES);
+    if (ctrl)
+    {
+        max_exposure = ctrl->maximum;
+        LOG( LOG_INFO, "V4L2 sensor get_maximum_exposure: max_exposure=%d", max_exposure );
+    }
+    else
+    {
+        LOG( LOG_ERR, "V4L2 sensor get_maximum_exposure: control not found!" );
+    }
+    return max_exposure;
+}
+static int get_bayer_pattern(sensor_context_t * p_ctx)
+{
+    struct v4l2_ctrl *ctrl;
+    int32_t bayer_pattern = 0;
+
+    /* Find the control within the subdev's handler */
+    ctrl = v4l2_ctrl_find(p_ctx->v4l_subdev->ctrl_handler, V4L2_CID_ACAMERA_SENSOR_BAYER_FORMAT);
+    if (ctrl)
+    {
+        bayer_pattern = v4l2_ctrl_g_ctrl(ctrl);
+    }
+    else
+    {
+        LOG( LOG_ERR, "V4L2 sensor get_bayer_pattern: control not found!" );
+    }
+    return bayer_pattern;
+}
+
+//--------------------FLASH------------------------------------------------------------
+
+static int32_t sensor_alloc_analog_gain( void *ctx, int32_t gain )
+{
+    LOG( LOG_INFO, "V4L2 sensor alloc_analog_gain called." );
+    sensor_context_t *p_ctx = ctx;
+
+    if (gain > p_ctx->param.again_log2_max) {
+        gain = p_ctx->param.again_log2_max; 
+    }
+    
+    p_ctx->again_change = 1;
+    p_ctx->again_log2 = gain;
+
+    return gain;
+}
+
+static int32_t sensor_alloc_digital_gain( void *ctx, int32_t gain )
+{
+    LOG( LOG_INFO, "V4L2 sensor alloc_digital_gain called." );
+    sensor_context_t *p_ctx = ctx;
+
+    if (gain > p_ctx->param.dgain_log2_max){
+        gain = p_ctx->param.dgain_log2_max; 
+    }
+
+    p_ctx->dgain_change = 1;
+    p_ctx->dgain_log2 = gain;
+    return gain;
+}
+
+static void sensor_alloc_integration_time( void *ctx, uint16_t *int_time, uint16_t *int_time_M, uint16_t *int_time_L )
+{
+    LOG( LOG_INFO, "V4L2 sensor alloc_integration_time called. " );
+    sensor_context_t *p_ctx = ctx;
+    // Max exposure in lines for the current framerate
+
+    if ( *int_time < p_ctx->param.integration_time_min ) {
+        *int_time = p_ctx->param.integration_time_min;
+    } else if (*int_time > p_ctx->param.integration_time_max){
+        *int_time = p_ctx->param.integration_time_max;
+    }
+
+    p_ctx->exposure_change = 1;
+    p_ctx->int_time = *int_time;
+}
+
+static void sensor_update( void *ctx )
+{
+    LOG( LOG_INFO, "V4L2 sensor update called." );
+    if (ctx) {
+        sensor_context_t *p_ctx = ctx;
+        struct v4l2_ctrl *ctrl;
+        if ( p_ctx->exposure_change ) {
+            p_ctx->exposure_change = 0;
+            ctrl = v4l2_ctrl_find(p_ctx->v4l_subdev->ctrl_handler, V4L2_CID_ACAMERA_SENSOR_EXPOSURE_LINES);
+            if (ctrl)
+            {
+                v4l2_ctrl_s_ctrl(ctrl, p_ctx->int_time);
+            }
+        }
+
+        if ( p_ctx->again_change ) {
+            p_ctx->again_change = 0;
+            ctrl = v4l2_ctrl_find(p_ctx->v4l_subdev->ctrl_handler, V4L2_CID_ACAMERA_SET_AGAIN_LOG2);
+            if (ctrl)
+            {
+                v4l2_ctrl_s_ctrl(ctrl, p_ctx->again_log2);
+            }
+        }
+
+        if ( p_ctx->dgain_change ) {
+            p_ctx->dgain_change = 0;
+            ctrl = v4l2_ctrl_find(p_ctx->v4l_subdev->ctrl_handler, V4L2_CID_ACAMERA_SET_DGAIN_LOG2);
+            if (ctrl)
+            {
+               v4l2_ctrl_s_ctrl(ctrl, p_ctx->dgain_log2);
+            }
+        }
+
+        LOG(LOG_INFO, "Sensor update: again_log2=%d dgain_log2=%d int_time=%u",
+            p_ctx->again_log2, p_ctx->dgain_log2, p_ctx->int_time);
+    }
+}
+
+static void sensor_set_mode( void *ctx, uint8_t mode )
+{
+    LOG( LOG_INFO, "V4L2 sensor set_mode called. mode: %d", mode );
+    sensor_context_t *p_ctx = ctx;
+    sensor_param_t *param = &p_ctx->param;
+
+    param->active.width = 1920;
+    param->active.height = 1080;
+    param->total.width = 1920;
+    param->total.height = 1080;
+    param->pixels_per_line = param->total.width;
+    param->integration_time_min = get_minimum_exposure(p_ctx);
+    param->integration_time_max = get_maximum_exposure(p_ctx);
+    param->integration_time_limit = get_maximum_exposure(p_ctx);
+    param->mode = mode;
+    param->lines_per_second = 0;
+    param->sensor_exp_number = param->modes_table[mode].exposures;
+}
+
+static uint16_t sensor_get_id( void *ctx )
+{
+    LOG( LOG_INFO, "V4L2 sensor get_id called. returning 0xffff" );
+    return 0xFFFF;
+}
+
+static const sensor_param_t *sensor_get_parameters( void *ctx )
+{
+    sensor_context_t *p_ctx = ctx;
+
+    LOG( LOG_INFO, "V4L2 sensor get_parameters called." );
+    return (const sensor_param_t *)&p_ctx->param;
+}
+
+static void sensor_disable_isp( void *ctx )
+{
+    LOG( LOG_INFO, "V4L2 sensor disable_isp called." );
+}
+
+static uint32_t read_register( void *ctx, uint32_t address )
+{
+    LOG( LOG_INFO, "V4L2 sensor read_register called. address: 0x%08x", address );
+    return 0;
+}
+
+static void write_register( void *ctx, uint32_t address, uint32_t data )
+{
+    LOG( LOG_INFO, "V4L2 sensor write_register called. address: 0x%08x, data: 0x%08x", address, data );
+}
+
+static void stop_streaming( void *ctx )
+{
+    sensor_context_t *p_ctx = ctx;
+    v4l2_subdev_call(p_ctx->v4l_subdev, video, s_stream, false);
+}
+
+static void start_streaming( void *ctx )
+{
+    sensor_context_t *p_ctx = ctx;
+    v4l2_subdev_call(p_ctx->v4l_subdev, video, s_stream, true);
+}
+
+void sensor_deinit_v4l2_subdev( void *ctx )
+{
+    LOG( LOG_INFO, "V4L2 sensor deinit called." );
+    if ( ctx ) {
+        sensor_context_t *p_ctx = ctx;
+        acamera_sbus_deinit( &p_ctx->sbus, sbus_i2c );
+
+        if ( --ctx_counter < 0 )
+            LOG( LOG_ERR, "Sensor context pointer is negative %d", ctx_counter );
+
+        if ( ctx_counter <= 0 ) {
+            reset_state = 0;
+            ctx_counter = 0;
+            reset_sensor_bus_counter();
+        }
+    }
+}
+//--------------------Initialization------------------------------------------------------------
+void sensor_init_v4l2_subdev( void **ctx, sensor_control_t *ctrl, const struct v4l2_subdev *sd)
+{
+    if ( ctx_counter < FIRMWARE_CONTEXT_NUMBER ) {
+        sensor_context_t *p_ctx = &s_ctx[ctx_counter];
+        ctx_counter++;
+
+        p_ctx->sbus.bus = get_next_sensor_bus_address();
+        p_ctx->sbus.device = 0; // Placeholder, this is a wrapper driver
+        p_ctx->sbus.mask = SBUS_MASK_SAMPLE_8BITS | SBUS_MASK_ADDR_16BITS | SBUS_MASK_ADDR_SWAP_BYTES | SBUS_MASK_NO_STOP;
+        if(!sd) {
+            LOG( LOG_ERR, "sensor_init_v4l2_subdev: v4l2_subdev is NULL!" );
+        }
+        LOG(LOG_INFO," sensor_init_v4l2_subdev: sd name=%s", sd->name);
+        p_ctx->v4l_subdev = (struct v4l2_subdev *)sd; // Store the subdev handle
+        acamera_sbus_init( &p_ctx->sbus, sbus_i2c );
+
+        p_ctx->param.rggb_start = get_bayer_pattern(p_ctx);
+        p_ctx->param.sensor_exp_number = 1;
+        p_ctx->param.again_log2_max = get_maximum_again(p_ctx);
+        p_ctx->param.dgain_log2_max = get_maximum_dgain(p_ctx);
+        p_ctx->param.integration_time_apply_delay = 2;
+        p_ctx->param.isp_exposure_channel_delay = 0;
+        p_ctx->param.modes_table = supported_modes;
+        p_ctx->param.modes_num = 1;
+        p_ctx->param.mode = 0;
+        p_ctx->param.integration_time_min = get_minimum_exposure(p_ctx);  // 1 line
+        p_ctx->param.integration_time_max = get_maximum_exposure(p_ctx);  // VMAX for 60fps
+        p_ctx->param.integration_time_limit = get_maximum_exposure(p_ctx);
+        p_ctx->param.sensor_ctx = p_ctx;
+        ctrl->alloc_analog_gain = sensor_alloc_analog_gain;
+        ctrl->alloc_digital_gain = sensor_alloc_digital_gain;
+        ctrl->alloc_integration_time = sensor_alloc_integration_time;
+        ctrl->sensor_update = sensor_update;
+        ctrl->set_mode = sensor_set_mode;
+        ctrl->get_id = sensor_get_id;
+        ctrl->get_parameters = sensor_get_parameters;
+        ctrl->disable_sensor_isp = sensor_disable_isp;
+        ctrl->read_sensor_register = read_register;
+        ctrl->write_sensor_register = write_register;
+        ctrl->start_streaming = start_streaming;
+        ctrl->stop_streaming = stop_streaming;
+        // Reset sensor during initialization
+        sensor_hw_reset_enable();
+        sensor_hw_reset_disable();
+
+        *ctx = p_ctx;
+
+    } else {
+        LOG( LOG_ERR, "Attempt to initialize more sensor instances than was configured. Sensor initialization failed." );
+        *ctx = NULL;
+    }
+}
+
+//*************************************************************************************
